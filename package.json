{
  "name": "webgames-project-forge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:rules": "node scripts/verify-rtdb-rules.mjs",
    "test:pvpstats": "node scripts/verify-pvpstats-rules.mjs",
    "test:contract": "esbuild scripts/verify-game-contract.ts --bundle --platform=node --format=esm --outfile=/tmp/project-forge-contract-verify.mjs && node /tmp/project-forge-contract-verify.mjs",
    "test:waitdog:sim": "esbuild scripts/waitdog-sim-contract.ts --bundle --platform=node --format=esm --outfile=/tmp/waitdog-sim-contract.mjs && node /tmp/waitdog-sim-contract.mjs",
    "test:waitdog:motion": "esbuild scripts/waitdog-motion-contract.ts --bundle --platform=node --format=esm --outfile=/tmp/waitdog-motion-contract.mjs && node /tmp/waitdog-motion-contract.mjs",
    "test:waitdog": "npm run test:waitdog:sim && npm run test:waitdog:motion",
    "test:lottery": "esbuild scripts/lottery-settle-contract.ts --bundle --platform=node --format=esm --outfile=/tmp/lottery-settle-contract.mjs && node /tmp/lottery-settle-contract.mjs",
    "bonpuri:build": "esbuild scripts/build-bonpuri-cards.ts --bundle --platform=node --format=esm --outfile=/tmp/bonpuri-build.mjs && node /tmp/bonpuri-build.mjs",
    "bonpuri:verify": "esbuild scripts/verify-bonpuri-data.ts --bundle --platform=node --format=esm --outfile=/tmp/bonpuri-verify.mjs && node /tmp/bonpuri-verify.mjs",
    "bonpuri:contract": "esbuild scripts/verify-bonpuri-contract.ts --bundle --platform=node --format=esm --outfile=/tmp/bonpuri-contract.mjs && node /tmp/bonpuri-contract.mjs",
    "bonpuri:sim": "esbuild scripts/simulate-bonpuri.ts --bundle --platform=node --format=esm --outfile=/tmp/bonpuri-sim.mjs && node /tmp/bonpuri-sim.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.6.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
